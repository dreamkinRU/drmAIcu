{
  "id": "github",
  "name": "GitHub Integration",
  "version": "1.1.0",
  "description": "GitHub integration for drmAIcu: GitHub App auth, repositories, branches, commits, pull requests, issues, Actions, sync",
  "author": "dreamkinRU",
  "api_version": "1.0",
  "entry_point": "plugin.py",
  "permissions": [
    "github.repositories.read",
    "github.contents.read",
    "github.contents.write",
    "github.branches.read",
    "github.branches.write",
    "github.commits.read",
    "github.commits.write",
    "github.pull_requests.read",
    "github.pull_requests.write",
    "github.issues.read",
    "github.issues.write",
    "github.actions.read",
    "github.actions.write",
    "github.pull_requests.merge",
    "github.repositories.delete"
  ],
  "settings_schema": {
    "app_id": {"type": "string", "default": "", "description": "App ID из настроек GitHub App"},
    "installation_id": {"type": "string", "default": "", "description": "Installation ID доступа к организациям/репозиториям"},
    "organization": {"type": "string", "default": "", "description": "Организация по умолчанию для быстрых действий"},
    "default_branch": {"type": "string", "default": "main", "description": "Ветка по умолчанию для дерева файлов"}
  }
}
