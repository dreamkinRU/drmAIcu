{
  "patch_id": "137-audit-logging",
  "version": "1.0",
  "type": "multi",
  "description": "Добавление аудит-логирования всех API-вызовов применения патчей",
  "operations": [
    {
      "type": "search_and_replace",
      "target_file": "main.py",
      "find": "    return JSONResponse(apply_patch(payload))\n",
      "replace": "    log('API apply: ' + str(payload.get('patch_id', 'unknown')), 'INFO')\n    return JSONResponse(apply_patch(payload))\n"
    }
  ]
}