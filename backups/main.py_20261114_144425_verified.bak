def create_ui():
    ui.dark_mode().enable()
    with ui.header().classes('bg-gray-900 text-white p-4'):
        ui.label('drmAIcu Core v3.1.2').classes('text-xl font-bold')

if __name__ in {"__main__", "__mp_main__"}:
    ensure_base_files()
    log_debug("Starting drmAIcu Core v3.1.2 PATCHMASTER...", "INFO")
    log_debug(f"BASE_DIR: {BASE_DIR}", "INFO")
    log_debug(f"PATCH_DIR exists: {os.path.exists(PATCH_DIR)}", "INFO")
    log_debug(f"PATCH_DIR contents: {os.listdir(PATCH_DIR) if os.path.exists(PATCH_DIR) else 'N/A'}", "INFO")
    get_engine()
    
    ui.run(
        title="drmAIcu Core",
        port=8080,
        reload=False,
        show=False,
        favicon="🤖"
    )