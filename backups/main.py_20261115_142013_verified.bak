EMERGENCY_ENGINE_CODE = '''# agent_engine.py (EMERGENCY)
import asyncio
import ollama
from typing import List, Dict

class AgentEngine:
    def __init__(self, config, **kwargs):
        self.config = config
        self.log = kwargs.get('log_callback', lambda msg, lvl: print(f"[{lvl}] {msg}"))
        self.log("Emergency engine loaded", "WARNING")

    async def get_code_response(self, candidate: Dict, prompt: str) -> Dict:
        try:
            loop = asyncio.get_running_loop()
            def do_req():
                return ollama.chat(model=candidate["model"], messages=[{"role": "user", "content": prompt}])
            response = await asyncio.wait_for(loop.run_in_executor(None, do_req), timeout=60.0)
            return {"candidate": candidate, "code": response['message']['content'], "error": None}
        except Exception as e:
            return {"candidate": candidate, "code": None, "error": str(e)}

    async def run_task(self, prompt: str, status_callback=None, mode: str = "full") -> str:
        self.log(f"TASK: {prompt[:50]}", "INFO")
        candidates = [{"model": "qwen2.5-coder:1.5b", "name": "Qwen 1.5B", "provider": "ollama"}]
        results = await asyncio.gather(*[self.get_code_response(c, prompt) for c in candidates], return_exceptions=True)
        valid = [r for r in results if isinstance(r, dict) and r.get("code")]
        return valid[0]["code"] if valid else "All models failed"
'''

# === КРИТИЧНЫЕ ФАЙЛЫ ===
CRITICAL_FILES = {
    'main.py', 'agent_engine.py', 'settings.json', 'launcher.bat',
    'package.json', 'package-lock.json', 'vite.config.js', 'tsconfig.json',
    'index.html', 'README.md', 'App.tsx', 'main.tsx', 'index.css'
}
CRITICAL_PATHS = {'src/', 'patch/', 'backups/', 'docs/'}
SKIP_FOLDERS = {'node_modules', '.git', '__pycache__', '.venv', 'venv', '.vscode', '.idea'}

# === ПАТТЕРНЫ LEGACY-ФАЙЛОВ ===
LEGACY_PATTERNS = [
    r'.*_v\d+\.\d+.*',       # main_v3.0.4.py, App_v2.1.tsx
    r'.*_v\d+.*',             # main_v3.py
    r'.*_fixed\..*',          # main_fixed.py
    r'.*_old\..*',            # main_old.py
    r'.*_backup\..*',         # main_backup.py
    r'.*_bak\..*',            # main_bak.py
    r'.*_ru\..*',             # main_ru.py (языковая копия)
    r'.*_en\..*',             # main_en.py
    r'.*_orig\..*',           # main_orig.py
    r'.*_prev\..*',           # main_prev.py
    r'.*\d+\.\d+\.\d+.*',     # main_v3.0.4.py (альтернативный паттерн)
]

# === ПАТТЕРНЫ МУСОРА ===
TRASH_PATTERNS = [
    r'.*\.tmp$',              # временные файлы
    r'.*\.pyc$',              # Python кэш
    r'.*\.pyo$',              # Python оптимизированный
    r'.*\.DS_Store$',         # macOS
    r'.*Thumbs\.db$',         # Windows
    r'.*desktop\.ini$',       # Windows
    r'.*ehthumbs\.db$',       # Windows
    r'.*\.log$',              # логи (если не нужны)
]

# === ЛОГИРОВАНИЕ ===
def log_debug(message: str, level: str = "INFO"):
    timestamp = datetime.now().strftime("%H:%M:%S")
    entry = {"time": timestamp, "level": level.lower(), "message": message, "source": "Core"}
    DEBUG_LOG.append(entry)
    if len(DEBUG_LOG) > 500:
        DEBUG_LOG.pop(0)
    print(f"[{timestamp}] [{level}] {message}")

# === УТИЛИТЫ ЧТЕНИЯ/ЗАПИСИ ===
def read_file_safe(filepath: str) -> str:
    encodings = ['utf-8', 'utf-8-sig', 'cp1251', 'windows-1251', 'latin-1', 'iso-8859-1']
    for enc in encodings:
        try:
            with open(filepath, 'r', encoding=enc) as f:
                content = f.read()
            if filepath.endswith('.json'):
                json.loads(content)
            return content
        except (UnicodeDecodeError, json.JSONDecodeError):
            continue
        except Exception:
            return ""
    raise ValueError(f"Не удалось прочитать файл: {filepath}")

def write_file_safe(filepath: str, content: str):
    with open(filepath, 'w', encoding='utf-8-sig') as f:
        f.write(content)

def compute_checksum(content: str) -> str:
    return hashlib.sha256(content.encode('utf-8')).hexdigest()

def compute_file_hash(filepath: str) -> str:
    try:
        with open(filepath, 'rb') as f:
            return hashlib.md5(f.read()).hexdigest()
    except:
        return ""

def human_size(size_bytes: int) -> str:
    if size_bytes < 1024:
        return f"{size_bytes} B"
    elif size_bytes < 1024 * 1024:
        return f"{size_bytes / 1024:.1f} KB"
    elif size_bytes < 1024 * 1024 * 1024:
        return f"{size_bytes / (1024 * 1024):.1f} MB"
    else:
        return f"{size_bytes / (1024 * 1024 * 1024):.2f} GB"

def read_file_preview(filepath: str, max_lines: int = 50) -> str:
    try:
        content = read_file_safe(filepath)
        lines = content.split('\n')
        if len(lines) > max_lines:
            return '\n'.join(lines[:max_lines]) + f'\n... ({len(lines) - max_lines} more lines)'
        return content
    except:
        return "[Не удалось прочитать]"

# === АНАЛИЗ БЕЗОПАСНОСТИ ФАЙЛА ===
def is_legacy_file(filename: str) -> bool:
    """Проверяет, является ли файл устаревшей версией"""
    for pattern in LEGACY_PATTERNS:
        if re.match(pattern, filename, re.IGNORECASE):
            return True
    return False

def is_trash_file(filename: str) -> bool:
    """Проверяет, является ли файл мусором"""
    if os.path.getsize(os.path.join(BASE_DIR, filename)) == 0 if os.path.exists(os.path.join(BASE_DIR, filename)) else False:
        return True
    for pattern in TRASH_PATTERNS:
        if re.match(pattern, filename, re.IGNORECASE):
            return True
    return False

def find_current_version(filename: str, all_files: list) -> str:
    """Находит текущую версию файла (без суффиксов _v, _old и т.д.)"""
    # Извлекаем базовое имя: main_v3.0.4.py -> main.py
    base_match = re.match(r'^(.+?)[_\-](?:v\d+|fixed|old|backup|bak|ru|en|orig|prev)\d*\.?(\d*\.?\d*)?(\..+)$', filename)
    if base_match:
        base_name = base_match.group(1) + base_match.group(3)
        if base_name in all_files:
            return base_name
    
    # Альтернатива: main_v3.0.4.py -> main.py
    base_match2 = re.match(r'^(.+?)_v[\d.]+(\..+)$', filename)
    if base_match2:
        base_name = base_match2.group(1) + base_match2.group(2)
        if base_name in all_files:
            return base_name
    
    return None

def extract_unique_features(content: str, filename: str) -> list:
    """Извлекает уникальные возможности из кода (функции, классы, импорты)"""
    features = []
    ext = os.path.splitext(filename)[1].lower()
    
    if ext == '.py':
        try:
            tree = ast.parse(content)
            for node in ast.walk(tree):
                if isinstance(node, ast.FunctionDef):
                    features.append(f"Функция: {node.name}()")
                elif isinstance(node, ast.ClassDef):
                    features.append(f"Класс: {node.name}")
                elif isinstance(node, ast.Import):
                    for alias in node.names:
                        features.append(f"Импорт: {alias.name}")
                elif isinstance(node, ast.ImportFrom):
                    features.append(f"Импорт из: {node.module}")
        except:
            pass
    
    elif ext in ('.tsx', '.ts', '.jsx', '.js'):
        # Ищем экспорты, компоненты, хуки
        exports = re.findall(r'export\s+(?:default\s+)?(?:function|class|const|let|var)\s+(\w+)', content)
        features.extend([f"Экспорт: {e}" for e in exports[:20]])
        
        hooks = re.findall(r'use[A-Z]\w+', content)
        unique_hooks = list(set(hooks))[:10]
        features.extend([f"Хук: {h}" for h in unique_hooks])
    
    return features[:30]  # Ограничиваем количество

def compare_files(content1: str, content2: str) -> dict:
    """Сравнивает два файла и возвращает различия"""
    lines1 = content1.splitlines()
    lines2 = content2.splitlines()
    
    unique_to_1 = set(lines1) - set(lines2)
    unique_to_2 = set(lines2) - set(lines1)
    
    similarity = len(set(lines1) & set(lines2)) / max(len(set(lines1) | set(lines2)), 1) * 100
    
    return {
        'similarity_percent': round(similarity, 1),
        'unique_lines_in_legacy': len(unique_to_1),
        'unique_lines_in_current': len(unique_to_2),
        'has_unique_code': len(unique_to_1) > 5  # Если больше 5 уникальных строк — стоит проверить
    }

def get_file_recommendation(filename: str, rel_path: str, content: str, all_files: list, all_contents: dict) -> dict:
    """Определяет рекомендацию по файлу"""
    # 1. Критичные файлы — всегда keep
    if filename in CRITICAL_FILES or any(rel_path.startswith(p) for p in CRITICAL_PATHS):
        return {
            'action': 'keep',
            'reason': 'Критичный файл системы',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 2. Пустые файлы — delete
    if len(content.strip()) == 0:
        return {
            'action': 'delete',
            'reason': 'Пустой файл',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 3. Файлы в public/ с дубликатами в корне
    if rel_path.startswith('public/') and filename in all_files:
        root_content = all_contents.get(filename, '')
        comparison = compare_files(content, root_content)
        
        if comparison['similarity_percent'] > 95:
            return {
                'action': 'delete',
                'reason': f'Дубликат корневого {filename} (совпадение {comparison["similarity_percent"]}%)',
                'confidence': 'high',
                'worth_reviewing': False,
                'duplicate_of': filename,
                'similarity': comparison['similarity_percent']
            }
        else:
            return {
                'action': 'review',
                'reason': f'Похож на {filename}, но есть различия ({comparison["similarity_percent"]}% совпадения)',
                'confidence': 'medium',
                'worth_reviewing': True,
                'duplicate_of': filename,
                'similarity': comparison['similarity_percent'],
                'unique_features': extract_unique_features(content, filename)
            }
    
    # 4. Legacy-файлы (устаревшие версии)
    if is_legacy_file(filename):
        current_version = find_current_version(filename, all_files)
        
        if current_version and current_version in all_contents:
            current_content = all_contents[current_version]
            comparison = compare_files(content, current_content)
            unique_features = extract_unique_features(content, filename)
            
            if comparison['has_unique_code'] and len(unique_features) > 3:
                return {
                    'action': 'review',
                    'reason': f'Устаревшая версия {current_version}, но содержит уникальный код',
                    'confidence': 'medium',
                    'worth_reviewing': True,
                    'current_version': current_version,
                    'similarity': comparison['similarity_percent'],
                    'unique_features': unique_features[:15],
                    'unique_lines_count': comparison['unique_lines_in_legacy']
                }
            else:
                return {
                    'action': 'archive',
                    'reason': f'Устаревшая версия {current_version} (совпадение {comparison["similarity_percent"]}%)',
                    'confidence': 'high',
                    'worth_reviewing': False,
                    'current_version': current_version,
                    'similarity': comparison['similarity_percent']
                }
        else:
            # Нет текущей версии — возможно, это единственный вариант
            unique_features = extract_unique_features(content, filename)
            return {
                'action': 'review',
                'reason': 'Устаревший формат имени, но текущая версия не найдена',
                'confidence': 'low',
                'worth_reviewing': True,
                'unique_features': unique_features[:15]
            }
    
    # 5. Файлы в backups/ — archive
    if rel_path.startswith('backups/') and not filename.endswith('_LATEST.bak'):
        return {
            'action': 'archive',
            'reason': 'Старый бэкап (не LATEST)',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 6. Файлы в patch/archive/ — archive
    if rel_path.startswith('patch/archive/'):
        return {
            'action': 'archive',
            'reason': 'Архивный патч',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 7. Python кэш
    if rel_path.startswith('__pycache__/') or filename.endswith('.pyc'):
        return {
            'action': 'delete',
            'reason': 'Python кэш',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 8. Временные файлы
    if filename.endswith('.tmp') or filename.startswith('!'):
        return {
            'action': 'delete',
            'reason': 'Временный файл',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 9. report.txt, diag.bat — временные
    if filename in ('report.txt', 'diag.bat', '!patch_system.txt'):
        return {
            'action': 'delete',
            'reason': 'Временный служебный файл',
            'confidence': 'high',
            'worth_reviewing': False
        }
    
    # 10. Старые HTML в public/
    if rel_path.startswith('public/') and filename.endswith('.html'):
        return {
            'action': 'review',
            'reason': 'HTML файл в public/ — возможно, старая версия интерфейса',
            'confidence': 'medium',
            'worth_reviewing': True,
            'unique_features': extract_unique_features(content, filename)[:10]
        }
    
    # 11. Старые MD в public/
    if rel_path.startswith('public/') and filename.endswith('.md'):
        return {
            'action': 'review',
            'reason': 'MD файл в public/ — возможно, старая документация',
            'confidence': 'medium',
            'worth_reviewing': True
        }
    
    # 12. api.py, backend/ — возможно, старый бэкенд
    if filename == 'api.py' or rel_path.startswith('backend/'):
        return {
            'action': 'review',
            'reason': 'Возможно, старый бэкенд — проверить перед удалением',
            'confidence': 'low',
            'worth_reviewing': True,
            'unique_features': extract_unique_features(content, filename)[:15]
        }
    
    # 13. src/services/api.ts, src/pages/Dashboard.tsx — возможно, неиспользуемый код
    if rel_path.startswith('src/services/') or rel_path.startswith('src/pages/'):
        return {
            'action': 'review',
            'reason': 'Возможно, неиспользуемый модуль — проверить импорты',
            'confidence': 'low',
            'worth_reviewing': True,
            'unique_features': extract_unique_features(content, filename)[:15]
        }
    
    # По умолчанию — keep
    return {
        'action': 'keep',
        'reason': 'Не определено как мусор',
        'confidence': 'low',
        'worth_reviewing': False
    }

# === КАТЕГОРИЗАЦИЯ ===
def categorize_file(filename: str, rel_path: str, size: int) -> str:
    if filename in CRITICAL_FILES:
        return 'critical'
    if any(rel_path.startswith(p) for p in CRITICAL_PATHS):
        return 'critical'
    if filename.endswith('.bak') or '_LATEST.bak' in filename:
        return 'backup'
    if filename.endswith('.tmp'):
        return 'trash'
    if filename in ('.DS_Store', 'Thumbs.db', 'desktop.ini', 'ehthumbs.db'):
        return 'trash'
    if size == 0:
        return 'trash'
    if rel_path.startswith('patch/archive/'):
        return 'archive'
    if rel_path.startswith('backups/'):
        return 'backup'
    if rel_path.startswith('project_archive/'):
        return 'archive'
    if filename.endswith('.md'):
        return 'docs'
    if filename.endswith(('.py', '.tsx', '.ts', '.jsx', '.js', '.vba', '.bas')):
        return 'code'
    if filename.endswith(('.json', '.yaml', '.yml', '.toml', '.ini', '.cfg', '.conf')):
        return 'config'
    if filename.endswith(('.log', '.txt')):
        return 'logs'
    if filename.endswith(('.bat', '.cmd', '.sh')):
        return 'scripts'
    if filename.endswith(('.html', '.css', '.scss')):
        return 'web'
    return 'other'

def get_file_icon(filename: str) -> str:
    ext = os.path.splitext(filename)[1].lower()
    icons = {
        '.py': '🐍', '.tsx': '⚛️', '.ts': '📘', '.jsx': '⚛️', '.js': '📜',
        '.json': '📋', '.md': '📝', '.bat': '⚙️', '.cmd': '⚙️',
        '.html': '🌐', '.css': '🎨', '.txt': '📄', '.log': '📃',
        '.bak': '💾', '.tmp': '🗑', '.vba': '📊', '.bas': '📊'
    }
    return icons.get(ext, '📄')

# === ВАЖНЫЕ ФАЙЛЫ ===
def load_important_files() -> set:
    if os.path.exists(IMPORTANT_FILE):
        try:
            with open(IMPORTANT_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                return set(data.get('important', []))
        except:
            pass
    return set()

def save_important_files(files: set):
    with open(IMPORTANT_FILE, 'w', encoding='utf-8') as f:
        json.dump({'important': list(files)}, f, indent=2)

# === КОНФИГУРАЦИЯ ===
def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "groq_api_key": "",
        "ollama_url": "http://localhost:11434",
        "openrouter_api_key": "",
        "gemini_api_key": ""
    }

def save_config(data):
    current = load_config()
    current.update(data)
    with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
        json.dump(current, f, indent=4, ensure_ascii=False)

# === ВАЛИДАЦИЯ ===
def validate_python_syntax(code: str) -> tuple:
    try:
        ast.parse(code)
        return True, None
    except SyntaxError as e:
        return False, str(e)

def validate_engine_structure(code: str) -> tuple:
    required = ['class AgentEngine', 'async def run_task', 'async def get_code_response', '__init__']
    missing = [r for r in required if r not in code]
    if missing:
        return False, f"Missing: {', '.join(missing)}"
    return True, None

def validate_typescript_basics(code: str) -> tuple:
    try:
        stack = []
        pairs = {'(': ')', '[': ']', '{': '}'}
        in_string = None
        escape = False
        for i, ch in enumerate(code):
            if escape:
                escape = False
                continue
            if ch == '\\':
                escape = True
                continue
            if in_string:
                if ch == in_string:
                    in_string = None
                continue
            if ch in ('"', "'", '`'):
                in_string = ch
                continue
            if ch in pairs:
                stack.append(pairs[ch])
            elif ch in pairs.values():
                if not stack or stack[-1] != ch:
                    return False, f"Несбалансированная скобка '{ch}' на позиции {i}"
                stack.pop()
        if stack:
            return False, f"Незакрытые скобки: {stack}"
        return True, None
    except Exception as e:
        return False, str(e)

def validate_json_syntax(code: str) -> tuple:
    try:
        json.loads(code)
        return True, None
    except json.JSONDecodeError as e:
        return False, str(e)

def validate_file(filename: str, content: str) -> tuple:
    ext = os.path.splitext(filename)[1].lower()
    if ext == '.py':
        ok, err = validate_python_syntax(content)
        if not ok:
            return False, f"Python syntax: {err}"
        if filename == 'agent_engine.py':
            ok2, err2 = validate_engine_structure(content)
            if not ok2:
                return False, f"Structure: {err2}"
        return True, None
    elif ext in ('.tsx', '.ts', '.jsx', '.js'):
        return validate_typescript_basics(content)
    elif ext == '.json':
        return validate_json_syntax(content)
    elif ext in ('.md', '.txt', '.bat', '.cmd', '.html', '.css'):
        return True, None
    else:
        return True, None

# === БЕКАПЫ ===
def create_triple_backup(filepath: str) -> list:
    if not os.path.exists(filepath):
        return []
    backups = []
    filename = os.path.basename(filepath)
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    backup1 = os.path.join(BACKUP_DIR, f"{filename}_{timestamp}.bak")
    backup2 = os.path.join(BACKUP_DIR, f"{filename}_{timestamp}_verified.bak")
    backup3 = os.path.join(BACKUP_DIR, f"{filename}_LATEST.bak")
    try:
        shutil.copy2(filepath, backup1); backups.append(backup1)
        shutil.copy2(filepath, backup2); backups.append(backup2)
        shutil.copy2(filepath, backup3); backups.append(backup3)
    except Exception:
        pass
    return backups

def restore_from_backup(filepath: str) -> bool:
    filename = os.path.basename(filepath)
    latest = os.path.join(BACKUP_DIR, f"{filename}_LATEST.bak")
    if os.path.exists(latest):
        try:
            shutil.copy2(latest, filepath)
            log_debug(f"Restored {filepath} from backup", "SUCCESS")
            return True
        except Exception as e:
            log_debug(f"Restore error: {e}", "ERROR")
    return False

def ensure_base_files():
    if not os.path.exists(CONFIG_FILE):
        save_config({})
    if not os.path.exists(ENGINE_FILE):
        log_debug("agent_engine.py not found, creating emergency engine", "WARNING")
        with open(ENGINE_FILE, 'w', encoding='utf-8') as f:
            f.write(EMERGENCY_ENGINE_CODE)
        return
    
    with open(ENGINE_FILE, 'r', encoding='utf-8') as f:
        content = f.read()
    
    v1, e1 = validate_python_syntax(content)
    v2, e2 = validate_engine_structure(content)
    
    if not v1 or not v2:
        log_debug("agent_engine.py CORRUPTED! Restoring...", "ERROR")
        if e1: log_debug(f"Syntax error: {e1}", "ERROR")
        if e2: log_debug(f"Structure error: {e2}", "ERROR")
        restore_from_backup(ENGINE_FILE)

# === ДВИЖОК ===
engine_instance = None
_engine_lock = threading.Lock()

def get_engine():
    global engine_instance
    with _engine_lock:
        if engine_instance is not None:
            return engine_instance
            
    config = load_config()
    if 'agent_engine' in sys.modules:
        importlib.reload(sys.modules['agent_engine'])
    else:
        import agent_engine
        
    try:
        engine_instance = sys.modules['agent_engine'].AgentEngine(config, log_callback=log_debug)
        log_debug("Engine loaded successfully", "SUCCESS")
        return engine_instance
    except Exception as e:
        log_debug(f"Engine error: {e}", "ERROR")
        log_debug(f"Traceback: {traceback.format_exc()}", "ERROR")
        restore_from_backup(ENGINE_FILE)
        return None

# === УТИЛИТЫ ДЛЯ ПАТЧЕЙ ===
def load_manifest() -> dict:
    if os.path.exists(MANIFEST_FILE):
        try:
            with open(MANIFEST_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception:
            pass
    return {"applied": [], "history": [], "rollbacks": []}

def save_manifest(manifest: dict):
    with open(MANIFEST_FILE, 'w', encoding='utf-8') as f:
        json.dump(manifest, f, indent=2, ensure_ascii=False)

def list_patches() -> list:
    patches = []
    manifest = load_manifest()
    applied_ids = {p['patch_id'] for p in manifest.get('applied', [])}
    
    if not os.path.exists(PATCH_DIR):
        return patches
    
    for filename in sorted(os.listdir(PATCH_DIR)):
        if not filename.endswith('.json') or filename.startswith('.') or filename.startswith('_'):
            continue
        
        filepath = os.path.join(PATCH_DIR, filename)
        if not os.path.isfile(filepath):
            continue
        
        try:
            content = read_file_safe(filepath)
            data = json.loads(content)
            
            patch_id = str(data.get('patch_id', filename.replace('.json', '').replace('patch_', '')))
            target_file = data.get('target_file', 'unknown')
            description = data.get('description', 'Без описания')
            author = data.get('author', 'Unknown')
            created_at = data.get('created_at', '')
            full_content = data.get('full_file_content', '')
            
            is_applied = patch_id in applied_ids
            file_exists = os.path.exists(target_file)
            
            checksum_ok = None
            if data.get('checksum') and file_exists:
                try:
                    with open(target_file, 'r', encoding='utf-8') as tf:
                        current_checksum = compute_checksum(tf.read())
                    checksum_ok = (current_checksum == data['checksum'].replace('sha256:', ''))
                except Exception:
                    checksum_ok = None
            
            patches.append({
                'filename': filename,
                'filepath': filepath,
                'patch_id': patch_id,
                'target_file': target_file,
                'description': description,
                'author': author,
                'created_at': created_at,
                'is_applied': is_applied,
                'file_exists': file_exists,
                'checksum_ok': checksum_ok,
                'content_length': len(full_content),
                'has_content': bool(full_content),
                'full_file_content': full_content
            })
        except Exception as e:
            patches.append({
                'filename': filename,
                'filepath': filepath,
                'patch_id': filename.replace('.json', '').replace('patch_', ''),
                'target_file': 'error',
                'description': f'Ошибка чтения: {str(e)[:100]}',
                'author': 'ERROR',
                'created_at': '',
                'is_applied': False,
                'file_exists': False,
                'checksum_ok': None,
                'content_length': 0,
                'has_content': False,
                'error': str(e),
                'full_file_content': ''
            })
    
    patches.sort(key=lambda p: p['patch_id'])
    return patches

def preview_patch(patch_data: dict) -> dict:
    target_file = patch_data.get('target_file', '')
    content = patch_data.get('full_file_content', '')
    
    if not target_file or not content:
        return {'success': False, 'error': 'Нет target_file или full_file_content'}
    
    file_exists = os.path.exists(target_file)
    old_content = ''
    if file_exists:
        try:
            with open(target_file, 'r', encoding='utf-8') as f:
                old_content = f.read()
        except Exception:
            try:
                with open(target_file, 'r', encoding='cp1251') as f:
                    old_content = f.read()
            except Exception as e:
                return {'success': False, 'error': f'Не удалось прочитать файл: {e}'}
    
    valid, error = validate_file(target_file, content)
    if not valid:
        return {'success': False, 'error': f'Валидация не пройдена: {error}', 'valid': False}
    
    old_lines = len(old_content.splitlines()) if old_content else 0
    new_lines = len(content.splitlines())
    size_diff = len(content) - len(old_content)
    
    return {
        'success': True,
        'valid': True,
        'target_file': target_file,
        'file_exists': file_exists,
        'old_size': len(old_content),
        'new_size': len(content),
        'old_lines': old_lines,
        'new_lines': new_lines,
        'size_diff': size_diff,
        'lines_diff': new_lines - old_lines,
        'checksum': compute_checksum(content),
        'message': f'✅ Патч валиден. Файл: {target_file} ({old_lines} → {new_lines} строк)'
    }

def apply_patch(patch_data: dict) -> dict:
    target_file = patch_data.get('target_file', '')
    content = patch_data.get('full_file_content', '')
    patch_id = patch_data.get('patch_id', 'unknown')
    action = patch_data.get('action', 'update')

    # Поддержка удаления файлов
    if action == 'delete':
        if not target_file:
            return {'success': False, 'error': 'Нет target_file для удаления'}
        full_path = os.path.join(BASE_DIR, target_file)
        if not os.path.exists(full_path):
            return {'success': True, 'message': f'Файл {target_file} уже удален или не существует'}
        try:
            create_triple_backup(full_path)
            os.remove(full_path)
            
            manifest = load_manifest()
            manifest['applied'].append({'patch_id': patch_id, 'target_file': target_file, 'applied_at': datetime.now().isoformat(), 'action': 'delete'})
            manifest['history'].append({'action': 'delete', 'patch_id': patch_id, 'target_file': target_file, 'timestamp': datetime.now().isoformat()})
            save_manifest(manifest)
            
            log_debug(f"File deleted via patch: {target_file}", "SUCCESS")
            return {'success': True, 'action': 'delete', 'message': f'Файл {target_file} успешно удален'}
        except Exception as e:
            log_debug(f"Delete error: {e}", "ERROR")
            return {'success': False, 'error': f'Ошибка удаления: {e}'}    
    if not target_file or not content:
        return {'success': False, 'error': 'Нет target_file или full_file_content'}
    
    valid, error = validate_file(target_file, content)
    if not valid:
        return {'success': False, 'error': f'Валидация не пройдена: {error}'}
    
    backups = create_triple_backup(target_file)
    
    temp_file = target_file + '.tmp'
    try:
        with open(temp_file, 'w', encoding='utf-8') as f:
            f.write(content)
        os.replace(temp_file, target_file)
        
        manifest = load_manifest()
        manifest['applied'].append({
            'patch_id': patch_id,
            'target_file': target_file,
            'applied_at': datetime.now().isoformat(),
            'checksum': compute_checksum(content),
            'backups': backups
        })
        manifest['history'].append({
            'action': 'apply',
            'patch_id': patch_id,
            'target_file': target_file,
            'timestamp': datetime.now().isoformat()
        })
        save_manifest(manifest)
        
        log_debug(f"Patch {patch_id} applied to {target_file}", "SUCCESS")
        
        return {
            'success': True,
            'message': f'Патч {patch_id} успешно применен к {target_file}',
            'backups': backups,
            'checksum': compute_checksum(content)
        }
    except Exception as e:
        if os.path.exists(temp_file):
            try:
                os.remove(temp_file)
            except Exception:
                pass
        log_debug(f"Patch apply error: {e}", "ERROR")
        return {'success': False, 'error': f'Ошибка применения: {e}'}

def rollback_last_patch() -> dict:
    manifest = load_manifest()
    if not manifest.get('applied'):
        return {'success': False, 'error': 'Нет примененных патчей для отката'}
    
    last = manifest['applied'][-1]
    target_file = last['target_file']
    patch_id = last['patch_id']
    
    filename = os.path.basename(target_file)
    latest_backup = os.path.join(BACKUP_DIR, f"{filename}_LATEST.bak")
    
    if not os.path.exists(latest_backup):
        return {'success': False, 'error': f'Бэкап не найден: {latest_backup}'}
    
    try:
        temp_file = target_file + '.tmp'
        shutil.copy2(latest_backup, temp_file)
        os.replace(temp_file, target_file)
        
        manifest['applied'].pop()
        manifest['rollbacks'].append({
            'patch_id': patch_id,
            'target_file': target_file,
            'rolled_back_at': datetime.now().isoformat()
        })
        manifest['history'].append({
            'action': 'rollback',
            'patch_id': patch_id,
            'target_file': target_file,
            'timestamp': datetime.now().isoformat()
        })
        save_manifest(manifest)
        
        log_debug(f"Rolled back patch {patch_id} for {target_file}", "SUCCESS")
        
        return {
            'success': True,
            'message': f'Патч {patch_id} откатен. Файл {target_file} восстановлен из бэкапа.'
        }
    except Exception as e:
        log_debug(f"Rollback error: {e}", "ERROR")
        return {'success': False, 'error': f'Ошибка отката: {e}'}

def archive_patch(filename: str) -> dict:
    src = os.path.join(PATCH_DIR, filename)
    dst = os.path.join(ARCHIVE_DIR, filename)
    
    if not os.path.exists(src):
        return {'success': False, 'error': 'Файл не найден'}
    
    if os.path.exists(dst):
        return {'success': False, 'error': 'Уже в архиве'}
    
    try:
        shutil.move(src, dst)
        return {'success': True, 'message': f'{filename} перемещен в архив'}
    except Exception as e:
        return {'success': False, 'error': str(e)}

def delete_patch(filename: str) -> dict:
    filepath = os.path.join(PATCH_DIR, filename)
    if not os.path.exists(filepath):
        return {'success': False, 'error': 'Файл не найден'}
    try:
        os.remove(filepath)
        return {'success': True, 'message': f'{filename} удален'}
    except Exception as e:
        return {'success': False, 'error': str(e)}

def get_stats() -> dict:
    patches = list_patches()
    manifest = load_manifest()
    
    total = len(patches)
    applied = len([p for p in patches if p['is_applied']])
    pending = total - applied
    errors = len([p for p in patches if 'error' in p])
    
    return {
        'total': total,
        'applied': applied,
        'pending': pending,
        'errors': errors,
        'history_count': len(manifest.get('history', [])),
        'rollbacks_count': len(manifest.get('rollbacks', [])),
        'backups_count': len(os.listdir(BACKUP_DIR)) if os.path.exists(BACKUP_DIR) else 0
    }

# === ГЛУБОКИЙ АНАЛИЗ ПРОЕКТА ===
def scan_project() -> dict:
    """Базовое сканирование (без глубокого анализа)"""
    files = []
    duplicates_map = {}
    important_files = load_important_files()
    
    for root, dirs, filenames in os.walk(BASE_DIR):
        dirs[:] = [d for d in dirs if d not in SKIP_FOLDERS]
        
        for filename in filenames:
            filepath = os.path.join(root, filename)
            rel_path = os.path.relpath(filepath, BASE_DIR)
            
            if filename in ('patch_manifest.json', 'checksums.json', '.project-important.json'):
                continue
            
            try:
                stat = os.stat(filepath)
                size = stat.st_size
                mtime = datetime.fromtimestamp(stat.st_mtime).isoformat()
                
                file_hash = compute_file_hash(filepath)
                category = categorize_file(filename, rel_path, size)
                preview = read_file_preview(filepath, max_lines=30)
                
                is_critical = filename in CRITICAL_FILES or any(rel_path.startswith(p) for p in CRITICAL_PATHS)
                is_important = rel_path in important_files
                
                file_info = {
                    'path': rel_path,
                    'filename': filename,
                    'size': size,
                    'size_human': human_size(size),
                    'modified': mtime,
                    'category': category,
                    'hash': file_hash,
                    'preview': preview,
                    'is_critical': is_critical,
                    'is_important': is_important,
                    'extension': os.path.splitext(filename)[1].lower(),
                    'icon': get_file_icon(filename)
                }
                
                files.append(file_info)
                
                if file_hash:
                    if file_hash not in duplicates_map:
                        duplicates_map[file_hash] = []
                    duplicates_map[file_hash].append(rel_path)
                    
            except Exception as e:
                files.append({
                    'path': rel_path,
                    'filename': filename,
                    'error': str(e),
                    'category': 'error',
                    'icon': '❓'
                })
    
    for file_info in files:
        if file_info.get('hash') and len(duplicates_map.get(file_info['hash'], [])) > 1:
            file_info['is_duplicate'] = True
            file_info['duplicates'] = [p for p in duplicates_map[file_info['hash']] if p != file_info['path']]
        else:
            file_info['is_duplicate'] = False
            file_info['duplicates'] = []
    
    stats = {
        'total': len(files),
        'total_size': sum(f.get('size', 0) for f in files),
        'total_size_human': human_size(sum(f.get('size', 0) for f in files)),
        'by_category': {},
        'by_extension': {},
        'duplicates_count': sum(1 for f in files if f.get('is_duplicate')),
        'duplicates_groups': sum(1 for v in duplicates_map.values() if len(v) > 1),
        'critical_count': sum(1 for f in files if f.get('is_critical')),
        'important_count': sum(1 for f in files if f.get('is_important')),
        'trash_count': sum(1 for f in files if f.get('category') == 'trash'),
        'backup_count': sum(1 for f in files if f.get('category') == 'backup')
    }
    
    for f in files:
        cat = f.get('category', 'unknown')
        stats['by_category'][cat] = stats['by_category'].get(cat, 0) + 1
        
        ext = f.get('extension', 'unknown')
        stats['by_extension'][ext] = stats['by_extension'].get(ext, 0) + 1
    
    return {'files': files, 'stats': stats}

def deep_analyze_project() -> dict:
    """Глубокий анализ с рекомендациями и защитой от потери кода"""
    log_debug("Starting deep project analysis...", "INFO")
    
    # Собираем все файлы и их содержимое
    all_files = []
    all_contents = {}
    all_filenames = set()
    
    for root, dirs, filenames in os.walk(BASE_DIR):
        dirs[:] = [d for d in dirs if d not in SKIP_FOLDERS]
        
        for filename in filenames:
            filepath = os.path.join(root, filename)
            rel_path = os.path.relpath(filepath, BASE_DIR)
            
            if filename in ('patch_manifest.json', 'checksums.json', '.project-important.json'):
                continue
            
            try:
                stat = os.stat(filepath)
                size = stat.st_size
                mtime = datetime.fromtimestamp(stat.st_mtime).isoformat()
                
                content = ""
                try:
                    content = read_file_safe(filepath)
                except:
                    pass
                
                all_filenames.add(filename)
                all_contents[rel_path] = content
                
                file_info = {
                    'path': rel_path,
                    'filename': filename,
                    'size': size,
                    'size_human': human_size(size),
                    'modified': mtime,
                    'category': categorize_file(filename, rel_path, size),
                    'icon': get_file_icon(filename),
                    'is_critical': filename in CRITICAL_FILES or any(rel_path.startswith(p) for p in CRITICAL_PATHS),
                    'is_important': rel_path in load_important_files(),
                    'extension': os.path.splitext(filename)[1].lower()
                }
                
                # Глубокий анализ
                recommendation = get_file_recommendation(filename, rel_path, content, list(all_contents.keys()), all_contents)
                file_info.update(recommendation)
                
                # Добавляем уникальные возможности для legacy-файлов
                if recommendation.get('worth_reviewing'):
                    file_info['unique_features'] = extract_unique_features(content, filename)[:20]
                
                all_files.append(file_info)
                
            except Exception as e:
                all_files.append({
                    'path': rel_path,
                    'filename': filename,
                    'error': str(e),
                    'category': 'error',
                    'icon': '❓',
                    'action': 'review',
                    'reason': f'Ошибка анализа: {str(e)}',
                    'confidence': 'low',
                    'worth_reviewing': True
                })
    
    # Статистика по рекомендациям
    stats = {
        'total': len(all_files),
        'total_size': sum(f.get('size', 0) for f in all_files),
        'total_size_human': human_size(sum(f.get('size', 0) for f in all_files)),
        'by_action': {},
        'by_category': {},
        'worth_reviewing_count': sum(1 for f in all_files if f.get('worth_reviewing')),
        'safe_to_delete_count': sum(1 for f in all_files if f.get('action') == 'delete'),
        'safe_to_archive_count': sum(1 for f in all_files if f.get('action') == 'archive'),
        'legacy_files_count': sum(1 for f in all_files if is_legacy_file(f.get('filename', ''))),
        'duplicate_files_count': sum(1 for f in all_files if f.get('action') == 'delete' and 'Дубликат' in f.get('reason', ''))
    }
    
    for f in all_files:
        action = f.get('action', 'unknown')
        stats['by_action'][action] = stats['by_action'].get(action, 0) + 1
        
        cat = f.get('category', 'unknown')
        stats['by_category'][cat] = stats['by_category'].get(cat, 0) + 1
    
    # Группировка по папкам
    by_folder = {}
    for f in all_files:
        folder = os.path.dirname(f['path']) or '(корень)'
        if folder not in by_folder:
            by_folder[folder] = []
        by_folder[folder].append(f)
    
    log_debug(f"Deep analysis complete: {stats['total']} files analyzed", "SUCCESS")
    
    return {
        'files': all_files,
        'stats': stats,
        'by_folder': by_folder,
        'summary': {
            'safe_to_delete': stats['safe_to_delete_count'],
            'safe_to_archive': stats['safe_to_archive_count'],
            'needs_review': stats['worth_reviewing_count'],
            'legacy_files': stats['legacy_files_count'],
            'duplicates': stats['duplicate_files_count']
        }
    }

# ==========================================
# FASTAPI ENDPOINTS
# ==========================================

@app.get("/api/status")
def api_status():
    config = load_config()
    ollama_ok = False
    try:
        import requests
        r = requests.get(f"{config.get('ollama_url', 'http://localhost:11434')}/api/tags", timeout=2)
        ollama_ok = r.status_code == 200
    except Exception:
        pass
    
    return JSONResponse({
        "ollama": "online" if ollama_ok else "offline",
        "guardian": "active",
        "version": "3.1.4 DEEP-ANALYZER",
        "providers": {
            "groq": bool(config.get('groq_api_key')),
            "openrouter": bool(config.get('openrouter_api_key')),
            "gemini": bool(config.get('gemini_api_key'))
        }
    })

@app.get("/api/logs")
def api_logs():
    return JSONResponse({"logs": DEBUG_LOG[-100:]})

@app.get("/api/md/{filename:path}")
def api_get_md(filename: str):
    safe_name = os.path.join(BASE_DIR, filename.replace("..", ""))
    if os.path.exists(safe_name):
        try:
            with open(safe_name, 'r', encoding='utf-8') as f:
                return JSONResponse({"content": f.read(), "name": filename})
        except Exception:
            try:
                with open(safe_name, 'r', encoding='cp1251') as f:
                    return JSONResponse({"content": f.read(), "name": filename})
            except Exception as e:
                return JSONResponse({"content": "", "name": filename, "error": str(e)})
    return JSONResponse({"content": "", "name": filename, "error": "File not found"})

@app.post("/api/md/{filename:path}")
def api_save_md(filename: str, payload: dict):
    safe_name = os.path.join(BASE_DIR, filename.replace("..", ""))
    try:
        with open(safe_name, 'w', encoding='utf-8') as f:
            f.write(payload.get("content", ""))
        log_debug(f"MD file saved: {safe_name}", "SUCCESS")
        return JSONResponse({"success": True})
    except Exception as e:
        return JSONResponse({"success": False, "error": str(e)})

@app.post("/api/task")
async def api_run_task(payload: dict):
    prompt = payload.get("prompt", "")
    log_debug(f"API Task received: {prompt[:50]}...", "INFO")
    engine = get_engine()
    if not engine:
        return JSONResponse({"error": "Engine not loaded", "result": "Ошибка загрузки движка"})
    try:
        result = await engine.run_task(prompt, mode="full")
        return JSONResponse({"success": True, "result": result})
    except Exception as e:
        log_debug(f"Task error: {e}", "ERROR")
        return JSONResponse({"success": False, "error": str(e), "result": "Ошибка выполнения"})

@app.get("/api/ollama/models")
def get_ollama_models():
    try:
        import requests
        config = load_config()
        r = requests.get(f"{config.get('ollama_url', 'http://localhost:11434')}/api/tags", timeout=5)
        if r.status_code == 200:
            models_data = r.json().get("models", [])
            formatted_models = [
                {"name": m["name"], "size_gb": round(m.get("size", 0) / (1024**3), 2)} 
                for m in models_data
            ]
            return JSONResponse({"success": True, "models": formatted_models})
        return JSONResponse({"success": False, "error": "Ollama не отвечает"})
    except Exception as e:
        return JSONResponse({"success": False, "error": str(e)})

@app.post("/api/ollama/pull")
async def pull_ollama_model(payload: dict):
    model_name = payload.get("name", "").strip()
    if not model_name:
        return JSONResponse({"success": False, "error": "Имя модели не указано"})
    
    log_debug(f"Запуск загрузки модели: {model_name}", "INFO")
    
    try:
        import ollama
        await asyncio.to_thread(ollama.pull, model_name)
        log_debug(f"Модель {model_name} успешно загружена!", "SUCCESS")
        return JSONResponse({"success": True, "message": f"Модель {model_name} готова к использованию"})
    except Exception as e:
        log_debug(f"Ошибка загрузки модели {model_name}: {e}", "ERROR")
        return JSONResponse({"success": False, "error": str(e)})

